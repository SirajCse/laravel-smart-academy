APP_NAME="Smart Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance mode (bypass IP)
APP_MAINTENANCE_IPS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL recommended - matches original CI3 schema)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_academy
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_STRICT_MODE=false

# Multi-branch (SaaS-style) database switching
MULTI_BRANCH_ENABLED=false
MULTI_BRANCH_DEFAULT_HOSTNAME=main

# Session / Cache / Queue / Filesystem
# SESSION_DRIVER can be "database" (requires sessions table) or "file" (default, no DB needed)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# CACHE_STORE can be "database" (requires cache table) or "file" (default, no DB needed)
CACHE_STORE=file
# QUEUE_CONNECTION can be "database" (requires jobs table) or "sync" (default, runs in-process)
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Two Auth Guards
AUTH_ADMIN_GUARD=admin
AUTH_STUDENT_GUARD=student

# Mail (defaults - actual mail config is stored in DB table `email_config`)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@smart-academy.local"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (actual SMS provider config stored in DB table `sms_config`)
SMS_DEFAULT_PROVIDER=

# File uploads
FILESYSTEM_PUBLIC_ROOT=public/uploads
FILESYSTEM_MAX_UPLOAD_MB=20

# Image proxy / cache
IMAGE_CACHE_LIFETIME=43200

# Encryption (used by Aes class - replaces CI3 hardcoded keys)
AES_CIPHER_KEY=
AES_CIPHER_METHOD=aes-256-cbc

# reCAPTCHA (optional)
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

# Firebase (push notifications)
FIREBASE_CREDENTIALS_JSON=
FIREBASE_DATABASE_URL=

# Omnipay payment gateways
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_SECRET=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Front-CMS active theme
FRONT_CMS_THEME=default
